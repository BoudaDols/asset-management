# Municipal Asset Management System - Environment Variables
# Copy this file to .env and adjust values for your environment.

# --- PostgreSQL (Central DB: catalog, tenants, users) ---
POSTGRES_DB=asset_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Central Database URL (used by FastAPI / SQLAlchemy) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
CENTRAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/asset_management

# --- AWS ---
AWS_REGION=ca-central-1

# --- AWS Lambda (background tasks: import, export) ---
LAMBDA_IMPORT_FUNCTION=sgam-import-processor
LAMBDA_EXPORT_FUNCTION=sgam-export-processor
# Set to false for local development (runs imports synchronously)
USE_LAMBDA=false

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- File Upload ---
# Maximum upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# --- Import Processing ---
# Number of rows per batch insert
BATCH_SIZE=100

# --- Pagination ---
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=500

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
