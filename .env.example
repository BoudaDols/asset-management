# Municipal Asset Management System - Environment Variables
# Copy this file to .env and adjust values for your environment.

# --- PostgreSQL ---
POSTGRES_DB=asset_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Database URL (used by FastAPI / SQLAlchemy) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/asset_management

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- File Upload ---
# Maximum upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# --- Import Processing ---
# Number of rows per batch insert
BATCH_SIZE=100

# --- Pagination ---
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=500

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
